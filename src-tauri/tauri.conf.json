{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FastPAS",
  "version": "0.1.1",
  "identifier": "com.fastpas.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../web-dist"
  },
  "app": {
    "windows": [
      {
        "title": "FastPAS",
        "width": 1500,
        "height": 980,
        "minWidth": 1200,
        "minHeight": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Standalone CyberArk authentication helper"
  }
}
